# =====================================================================
# Modele du fichier .env de PRODUCTION.
#
# CE fichier-ci est commite : il ne contient QUE des noms de variables,
# jamais de valeurs. Le .env reel n'existe que sur la VM.
#
# Sur la VM, a cote de docker-compose.prod.yml :
#
#   cp .env.example .env
#   nano .env            # renseigner les valeurs
#   chmod 600 .env       # lisible par le seul proprietaire
#
# .env et .env.* sont deja couverts par .gitignore. Un secret commite
# reste consultable dans l'historique Git meme apres suppression : il
# est compromis DEFINITIVEMENT, il faut le changer, pas l'effacer.
#
# Pour engendrer un mot de passe solide :
#   openssl rand -base64 24
# =====================================================================

# --- Version deployee ---------------------------------------------
# Tag des trois images sur GHCR, sans le "v" initial. Correspond a un
# tag Git du depot, donc a une version precise et reconstructible
# (NF-08) : le tag Git v0.1.0 produit les images 0.1.0.
# Exemple : 0.1.0
APP_VERSION=

# --- Base de donnees ----------------------------------------------
# Nom de la base. Doit valoir linux_distro_reco : les migrations
# Flyway et la configuration des deux services en dependent.
DB_NAME=

# Compte applicatif utilise par catalog-service. Ce n'est PAS root.
DB_USER=
DB_PASSWORD=

# Compte root de MySQL, utilise uniquement a l'initialisation du
# volume. Doit etre different de DB_PASSWORD.
DB_ROOT_PASSWORD=

# --- Rien d'autre --------------------------------------------------
# Aucune adresse de serveur n'est necessaire : le front appelle l'API
# sur sa propre origine et nginx relaie. Changer d'hebergeur ne
# demande donc ni modification de ce fichier, ni reconstruction des
# images.
